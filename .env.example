# העתיקי את הקובץ הזה לקובץ בשם .env ומלאי ערכים אמיתיים.
# לעולם אל תעלי את קובץ .env ל-GitHub.

# כתובת החיבור למסד הנתונים PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/borrowboard?schema=public"

# מסד נתונים נפרד לבדיקות אוטומטיות (npm test מוחק אותו בכל הרצה!)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/borrowboard_test?schema=public"

# מפתח סודי לחתימת JWT - לפחות 32 תווים אקראיים
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# תוקף ההתחברות (למשל 1d = יום, 12h = 12 שעות)
JWT_EXPIRES_IN="1d"

# כתובות האתר (React) שמותר להן לפנות לשרת, מופרדות בפסיק. * = כולם
CORS_ORIGIN="http://localhost:5173"

PORT=3000
NODE_ENV=development

# ---- רק לסביבת production (בענן) ----
# יצירת חשבון מנהל בהפעלה הראשונה
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="choose-a-strong-password"
# אופציונלי: יצירת משתמשות ונתוני הדגמה עם הסיסמה הזו
# SEED_DEMO_PASSWORD="choose-another-password"
